# Copy to .env and fill in your Atlas values:
#   cp .env.example .env

PORT=8787

# MongoDB Atlas
# Path after .net/ MUST be the DB name (narrative_styles), or writes go to "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/narrative_styles?retryWrites=true&w=majority
MONGODB_DB=narrative_styles
