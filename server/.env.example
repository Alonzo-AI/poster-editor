# Copy to .env and fill in your Atlas values:
#   cp .env.example .env

PORT=8787

# MongoDB Atlas (recommended)
# 1. Atlas → Database → Connect → Drivers → copy the SRV string
# 2. Replace <password> (URL-encode special chars: @ → %40, etc.)
# 3. Network Access → add your IP (or 0.0.0.0/0 for quick local testing)
# 4. Database Access → user with readWrite on this DB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/narrative_styles?retryWrites=true&w=majority

# Local Mongo instead of Atlas:
# MONGODB_URI=mongodb://127.0.0.1:27017/narrative_styles
