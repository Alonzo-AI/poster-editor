# Copy to .env and fill in your Atlas values:
#   cp .env.example .env

PORT=8787

# MongoDB Atlas
# Path after .net/ MUST be the DB name (narrative_styles), or writes go to "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/narrative_styles?retryWrites=true&w=majority
MONGODB_DB=narrative_styles

# S3 image uploads (new images → URL in template JSON; existing base64 docs unchanged)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
# Optional public CDN/base URL (no trailing slash).
# If empty, the API stores /api/media/<key> (works with private buckets).
# If set, that public URL is stored in Mongo instead.
# S3_PUBLIC_BASE_URL=

# --- External Stories portal API (additive; does not change Editor/Automate/Projects) ---
# Required for /api/external/* (Bearer or X-Api-Key). Leave empty to keep those routes disabled (503).
EXTERNAL_API_TOKEN=
# React app origin for Edit deep-links returned to Stories (no trailing slash).
PUBLIC_APP_ORIGIN=http://127.0.0.1:8518

# --- QA Graphics Testing spreadsheet (Postgres only; optional — Editor still runs without it) ---
# Prefer discrete creds:
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional: DB_SSL=require  (auto for many cloud hosts)
# Or a single URL instead of DB_* :
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=

# --- Auto Stories → LLM extract → QA Graphics (additive; optional) ---
# Same keys as Script_Testing. Required for Home → Auto Stories.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_REFERER=
# OPENROUTER_TITLE=Poster Lab Auto Stories

