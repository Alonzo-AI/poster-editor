{
  "id": "sideline_text",
  "name": "Sideline Text",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1350,
    "background": "#E8E0D4"
  },
  "deco": {
    "html": ""
  },
  "textRules": {
    "autoFit": ["heroNumber", "heroDesc", "playerName", "callout", "teamName", "hashtag"],
    "stats": {
      "autoFit": false
    }
  },
  "settings": {
    "logo": {
      "opacity": 1,
      "scale": 1
    },
    "brandColors": {
      "fromLogo": false
    },
    "playerImage": {
      "fitToFrame": false,
      "fit": "contain",
      "cropX": 0.55,
      "cropY": 0.4,
      "zoom": 1
    }
  },
  "layers": [
    {
      "id": "bgImage",
      "type": "image",
      "bind": "background",
      "x": 0,
      "y": 0,
      "w": 1080,
      "h": 1350,
      "fit": "cover",
      "z": 1
    },
    {
      "id": "player",
      "type": "image",
      "bind": "player",
      "x": 430,
      "y": 36,
      "w": 650,
      "h": 1160,
      "fit": "contain",
      "zoom": 1,
      "cropX": 0.55,
      "cropY": 0.4,
      "z": 12
    },
    {
      "id": "logo",
      "type": "image",
      "bind": "logo",
      "x": 176,
      "y": 116,
      "w": 90,
      "h": 70,
      "fit": "contain",
      "z": 21
    },
    {
      "id": "conference",
      "type": "image",
      "bind": "conference",
      "x": 270,
      "y": 122,
      "w": 118,
      "h": 60,
      "fit": "contain",
      "z": 21
    },
    {
      "id": "sponsor",
      "type": "image",
      "bind": "sponsor",
      "x": 88,
      "y": 1230,
      "w": 140,
      "h": 72,
      "fit": "contain",
      "z": 22
    },
    {
      "id": "teamName",
      "type": "text",
      "bind": "teamName",
      "placeholder": "VS. ULM | 23-8 |",
      "x": 80,
      "y": 248,
      "w": 420,
      "h": 36,
      "size": 22,
      "color": "primary",
      "font": "sans",
      "weight": 700,
      "italic": true,
      "align": "center",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "hashtag",
      "type": "text",
      "bind": "hashtag",
      "placeholder": "OCT. 11, 2025",
      "x": 72,
      "y": 308,
      "w": 400,
      "h": 50,
      "size": 24,
      "color": "black",
      "font": "sans",
      "weight": 800,
      "align": "center",
      "ls": 1,
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "hero",
      "type": "text",
      "bind": "heroNumber",
      "placeholder": "300",
      "x": 40,
      "y": 428,
      "w": 520,
      "h": 220,
      "size": 208,
      "color": "primary",
      "font": "cond",
      "weight": 700,
      "lh": 0.84,
      "align": "center",
      "z": 22
    },
    {
      "id": "heroDesc",
      "type": "text",
      "bind": "heroDesc",
      "placeholder": "FIELD GOALS",
      "x": 40,
      "y": 768,
      "w": 540,
      "h": 72,
      "size": 48,
      "color": "primary",
      "font": "cond",
      "weight": 600,
      "ls": 2,
      "align": "center",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "callout",
      "type": "text",
      "bind": "callout",
      "placeholder": "MOST IN THE SBC THIS WEEK",
      "x": 40,
      "y": 968,
      "w": 520,
      "h": 40,
      "size": 20,
      "color": "black",
      "font": "sans",
      "weight": 700,
      "italic": true,
      "ls": 1,
      "align": "center",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "playerName",
      "type": "text",
      "bind": "playerName",
      "placeholder": "KIAN AFROOKHTEH",
      "x": 560,
      "y": 1084,
      "w": 480,
      "h": 48,
      "size": 32,
      "color": "black",
      "font": "sans",
      "weight": 800,
      "italic": true,
      "align": "left",
      "ls": 1,
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "playerMeta",
      "type": "text",
      "bind": "playerMeta",
      "placeholder": "JUNIOR | K",
      "x": 560,
      "y": 1138,
      "w": 400,
      "h": 32,
      "size": 20,
      "color": "black",
      "font": "sans",
      "weight": 600,
      "italic": true,
      "align": "left",
      "ls": 1,
      "z": 22,
      "textTransform": "uppercase"
    }
  ]
}
