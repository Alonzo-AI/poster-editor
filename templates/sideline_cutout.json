      "weight": 700,
      "italic": true,
      "ls": 1,
      "align": "center",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "playerName",
      "type": "text",
      "bind": "playerName",
      "x": 580,
      "y": 1084,
      "w": 470,
      "h": 48,
      "size": 32,
      "color": "white",
      "font": "sans",
