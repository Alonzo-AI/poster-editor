      "y": 248,
      "w": 260,
      "h": 36,
      "size": 22,
      "color": "primary",
      "font": "sans",
      "weight": 700,
      "italic": true,
      "align": "center",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
