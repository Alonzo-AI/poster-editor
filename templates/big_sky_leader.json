{
  "id": "big_sky_leader",
  "name": "Big Sky Leader",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1350,
    "background": "{{contrast}}"
  },
  "deco": {
    "html": "<div style=\"left:0;top:0;width:142px;height:940px;background:{{contrast}};z-index:8;\"></div><div style=\"left:0;top:0;width:142px;height:168px;background:{{primary}};clip-path:polygon(0 0,100% 0,100% 76%,58% 100%,0 76%);z-index:9;\"></div><div style=\"left:0;top:720px;width:142px;height:220px;background:{{primary}};clip-path:polygon(0 12%,58% 100%,100% 12%,100% 0,58% 84%,0 0);z-index:9;\"></div><div style=\"left:16px;top:742px;width:110px;height:162px;background:{{contrast}};clip-path:polygon(0 12%,50% 76%,100% 12%,100% 0,50% 64%,0 0);z-index:10;\"></div><div style=\"left:0;top:940px;width:1080px;height:4px;background:{{onContrast}};z-index:11;\"></div><div style=\"left:0;top:1220px;width:1080px;height:3px;background:{{onContrast}};z-index:11;\"></div>"
  },
  "textRules": {
    "autoFit": ["eyebrow", "heroNumber", "heroDesc", "playerName", "callout", "teamName"],
    "stats": {
      "autoFit": true,
      "maxSize": 54
    }
  },
  "settings": {
    "logo": {
      "opacity": 1,
      "scale": 1
    },
    "brandColors": {
      "fromLogo": false
    },
    "playerImage": {
      "fitToFrame": true,
      "fit": "cover",
      "cropX": 0.58,
      "cropY": 0.38,
      "zoom": 1
    }
  },
  "layers": [
    {
      "id": "player",
      "type": "image",
      "bind": "player",
      "x": 0,
      "y": 0,
      "w": 1080,
      "h": 1350,
      "fit": "cover",
      "zoom": 1,
      "cropX": 0.58,
      "cropY": 0.38,
      "z": 2
    },
    {
      "id": "logo",
      "type": "image",
      "bind": "logo",
      "x": 18,
      "y": 16,
      "w": 104,
      "h": 104,
      "fit": "contain",
      "z": 20
    },
    {
      "id": "eyebrow",
      "type": "text",
      "bind": "eyebrow",
      "x": -308,
      "y": 382,
      "w": 760,
      "size": 48,
      "color": "onContrast",
      "font": "disp",
      "weight": 800,
      "align": "center",
      "ls": 2,
      "z": 20,
      "textTransform": "uppercase",
      "transform": "rotate(-90deg)"
    },
    {
      "id": "statBand",
      "type": "block",
      "x": 0,
      "y": 944,
      "w": 1080,
      "h": 276,
      "fill": "contrast",
      "z": 10
    },
    {
      "id": "divider",
      "type": "block",
      "x": 538,
      "y": 1018,
      "w": 4,
      "h": 150,
      "fill": "primary",
      "z": 21
    },
    {
      "id": "hero",
      "type": "text",
      "bind": "heroNumber",
      "x": 72,
      "y": 974,
      "w": 390,
      "h": 160,
      "size": 150,
      "color": "onContrast",
      "font": "disp",
      "weight": 900,
      "lh": 0.9,
      "align": "left",
      "z": 22
    },
    {
      "id": "heroDesc",
      "type": "text",
      "bind": "heroDesc",
      "x": 70,
      "y": 1122,
      "w": 410,
      "h": 48,
      "size": 25,
      "color": "primary",
      "font": "cond",
      "weight": 800,
      "ls": 1,
      "align": "left",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "callout",
      "type": "text",
      "bind": "callout",
      "x": 70,
      "y": 1172,
      "w": 410,
      "h": 38,
      "size": 20,
      "color": "onContrast",
      "font": "sans",
      "weight": 600,
      "align": "left",
      "z": 22
    },
    {
      "id": "stat1",
      "type": "text",
      "bind": "stat1",
      "kind": "stat",
      "statStack": true,
      "x": 620,
      "y": 1016,
      "w": 360,
      "h": 120,
      "size": 58,
      "color": "onContrast",
      "labelColor": "primary",
      "font": "cond",
      "weight": 800,
      "align": "center",
      "z": 22
    },
    {
      "id": "stat2",
      "type": "text",
      "bind": "stat2",
      "kind": "stat",
      "statStack": true,
      "x": 620,
      "y": 1142,
      "w": 360,
      "h": 56,
      "size": 22,
      "color": "primary",
      "labelColor": "onContrast",
      "font": "sans",
      "weight": 700,
      "align": "center",
      "z": 22
    },
    {
      "id": "footerBand",
      "type": "block",
      "x": 0,
      "y": 1223,
      "w": 1080,
      "h": 127,
      "fill": "contrast",
      "z": 10
    },
    {
      "id": "playerName",
      "type": "text",
      "bind": "playerName",
      "x": 120,
      "y": 1238,
      "w": 840,
      "h": 56,
      "size": 56,
      "color": "onContrast",
      "font": "disp",
      "weight": 800,
      "align": "center",
      "ls": 1,
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "playerMeta",
      "type": "text",
      "bind": "playerMeta",
      "x": 160,
      "y": 1294,
      "w": 760,
      "h": 30,
      "size": 24,
      "color": "primary",
      "font": "sans",
      "weight": 600,
      "align": "center",
      "z": 22
    },
    {
      "id": "teamName",
      "type": "text",
      "bind": "teamName",
      "x": 160,
      "y": 1320,
      "w": 760,
      "h": 22,
      "size": 18,
      "color": "onContrast",
      "font": "sans",
      "weight": 600,
      "align": "center",
      "z": 22
    }
  ]
}
