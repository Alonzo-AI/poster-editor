{
  "id": "cutout_splat",
  "name": "Cutout Splat",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1350,
    "background": "{{secondary}}"
  },
  "deco": {
    "html": "<style>#stage[data-template=\"cutout_splat\"] .layer[data-id=\"playerName\"]{font-style:italic!important;text-transform:uppercase!important}#stage[data-template=\"cutout_splat\"] .layer[data-id=\"playerMeta\"]{text-transform:uppercase!important;letter-spacing:1.5px!important}#stage[data-template=\"cutout_splat\"] .layer[data-id=\"footer\"] .game-loc{color:#111!important;font-weight:800}#stage[data-template=\"cutout_splat\"] .layer[data-id=\"footer\"] .game-meta{color:{{primary}}!important;font-weight:700}</style><div style=\"inset:0;z-index:1;background:repeating-linear-gradient(0deg,rgba(20,18,16,.045) 0 1px,transparent 1px 3px),repeating-linear-gradient(90deg,rgba(20,18,16,.03) 0 1px,transparent 1px 4px);pointer-events:none;\"></div><svg viewBox=\"0 0 1080 1350\" preserveAspectRatio=\"none\" style=\"position:absolute;inset:0;width:100%;height:100%;z-index:4;pointer-events:none;\"><path fill=\"{{primary}}\" d=\"M612 0c48 86 128 70 198 118 62 42 96 8 168 54 38 24 70 18 102 46v1132H498c38-92 156-148 172-268 18-132-96-168-18-286 64-96 128-132 96-232-28-88-122-96-84-198 28-76 122-92 148-166 18-52-18-92-48-132 22-28 52-48 48-68z\"/><path fill=\"{{primary}}\" opacity=\".88\" d=\"M780 70c40-28 92-18 140-8 28 6 88-22 160 12v220c-70-8-118 18-168-6-62-30-86-42-132-38-22 2-28-28 0-180z\"/><path fill=\"{{primary}}\" opacity=\".55\" d=\"M540 980c80 20 120-40 210-10 70 24 90 8 160 36 40 16 90-6 170 18v326H430c40-90 70-140 110-370z\"/></svg><div style=\"left:430px;top:1110px;width:720px;height:240px;background:{{primary}};clip-path:polygon(16% 0,100% 0,100% 100%,0 100%);z-index:18;pointer-events:none;\"></div>"
  },
  "textRules": {
    "autoFit": ["heroNumber", "heroDesc", "playerName", "callout", "footer", "teamName"],
    "stats": {
      "autoFit": true,
      "maxSize": 40
    }
  },
  "settings": {
    "logo": {
      "opacity": 1,
      "scale": 1
    },
    "brandColors": {
      "fromLogo": false
    },
    "playerImage": {
      "fitToFrame": false,
      "fit": "contain",
      "cropX": 0.5,
      "cropY": 0.42,
      "zoom": 1
    }
  },
  "layers": [
    {
      "id": "player",
      "type": "image",
      "bind": "player",
      "x": 390,
      "y": 70,
      "w": 690,
      "h": 1120,
      "fit": "contain",
      "zoom": 1,
      "cropX": 0.52,
      "cropY": 0.42,
      "z": 12
    },
    {
      "id": "logo",
      "type": "image",
      "bind": "logo",
      "x": 478,
      "y": 28,
      "w": 124,
      "h": 100,
      "fit": "contain",
      "z": 22
    },
    {
      "id": "hero",
      "type": "text",
      "bind": "heroNumber",
      "x": 48,
      "y": 168,
      "w": 540,
      "h": 150,
      "size": 148,
      "color": "primary",
      "font": "cond",
      "weight": 700,
      "lh": 0.86,
      "align": "left",
      "z": 22
    },
    {
      "id": "heroDesc",
      "type": "text",
      "bind": "heroDesc",
      "x": 52,
      "y": 318,
      "w": 500,
      "h": 48,
      "size": 36,
      "color": "primary",
      "font": "cond",
      "weight": 600,
      "ls": 2,
      "align": "left",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "conference",
      "type": "image",
      "bind": "conference",
      "x": 52,
      "y": 548,
      "w": 118,
      "h": 118,
      "fit": "contain",
      "z": 22
    },
    {
      "id": "callout",
      "type": "text",
      "bind": "callout",
      "x": 186,
      "y": 560,
      "w": 420,
      "h": 44,
      "size": 28,
      "color": "black",
      "font": "sans",
      "weight": 800,
      "align": "left",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "eyebrow",
      "type": "text",
      "bind": "eyebrow",
      "x": 186,
      "y": 606,
      "w": 420,
      "h": 36,
      "size": 22,
      "color": "black",
      "font": "sans",
      "weight": 600,
      "ls": 1,
      "align": "left",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "footer",
      "type": "text",
      "bind": "footer",
      "x": 48,
      "y": 1184,
      "w": 500,
      "h": 40,
      "size": 22,
      "color": "black",
      "font": "sans",
      "weight": 700,
      "align": "left",
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "sponsor",
      "type": "image",
      "bind": "sponsor",
      "x": 48,
      "y": 1240,
      "w": 210,
      "h": 78,
      "fit": "contain",
      "z": 22
    },
    {
      "id": "playerMeta",
      "type": "text",
      "bind": "playerMeta",
      "x": 560,
      "y": 1160,
      "w": 470,
      "h": 32,
      "size": 22,
      "color": "white",
      "font": "sans",
      "weight": 600,
      "align": "left",
      "ls": 2,
      "z": 22,
      "textTransform": "uppercase"
    },
    {
      "id": "playerName",
      "type": "text",
      "bind": "playerName",
      "x": 540,
      "y": 1196,
      "w": 500,
      "h": 72,
      "size": 54,
      "color": "white",
      "font": "sans",
      "weight": 800,
      "italic": true,
      "align": "left",
      "ls": 0,
      "z": 22,
      "textTransform": "uppercase"
    }
  ]
}
