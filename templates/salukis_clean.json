{
  "id": "salukis_clean",
  "name": "Salukis Clean",
  "version": 1,
  "canvas": { "width": 1080, "height": 1350, "background": "#ffffff" },
  "layoutRules": {
    "salukisCleanStatSlots": { "top": 230, "bottom": 1170 }
  },
  "textRules": {
    "footer": { "salukisMode": "teamNameOnly" },
    "stats": { "autoFit": true, "defaultSize": 150 }
  },
  "deco": {
    "html": "<style>#stage[data-template=\"salukis_clean\"] .layer[data-id=\"playerName\"],#stage[data-template=\"salukis_clean\"] .layer[data-id=\"playerMeta\"]{font-family:'Bebas Neue',sans-serif!important;text-transform:uppercase!important}#stage[data-template=\"salukis_clean\"] .layer[data-id^=\"stat\"]{flex-direction:column!important;align-items:flex-start!important;justify-content:center!important;gap:0!important;overflow:hidden!important}#stage[data-template=\"salukis_clean\"] .layer[data-id^=\"stat\"] .s-n{font-family:'Bebas Neue',sans-serif!important;font-weight:400!important;line-height:0.9!important;color:{{contrast}}!important;width:100%!important}#stage[data-template=\"salukis_clean\"] .layer[data-id^=\"stat\"] .s-l{font-family:'Oswald',sans-serif!important;font-size:22px!important;font-weight:800!important;color:{{primary}}!important;letter-spacing:0.5px!important;text-transform:uppercase!important;max-width:100%!important;line-height:1.15!important;flex-shrink:0!important}</style><div style=\"left:0;bottom:0;width:100%;height:90px;background:{{primary}};z-index:10;\"></div>"
  },
  "layers": [
    { "id": "logo", "type": "image", "bind": "logo", "x": 60, "y": 50, "w": 180, "h": 110, "z": 20 },
    { "id": "playerName", "type": "text", "bind": "playerName", "x": 420, "y": 52, "w": 600, "size": 76, "color": "primary", "font": "bebas", "weight": 400, "ls": 2, "align": "right", "textTransform": "uppercase" },
    { "id": "playerMeta", "type": "text", "bind": "playerMeta", "x": 420, "y": 128, "w": 600, "size": 40, "color": "primary", "font": "bebas", "weight": 400, "ls": 2, "align": "right", "hollow": true, "strokeW": 1.5, "textTransform": "uppercase" },
    { "id": "player", "type": "image", "bind": "player", "x": 60, "y": 190, "w": 520, "h": 980, "fit": "cover", "z": 5, "border": true, "borderColor": "primary" },
    { "id": "eyebrow", "type": "text", "bind": "eyebrow", "x": 640, "y": 200, "w": 380, "size": 20, "color": "primary", "font": "cond", "weight": 800, "ls": 1, "textTransform": "uppercase" },
    { "id": "stat1", "type": "text", "bind": "stat1", "kind": "stat", "statStack": true, "x": 640, "y": 230, "w": 380, "h": 313, "size": 150, "font": "bebas", "align": "left", "z": 18 },
    { "id": "stat2", "type": "text", "bind": "stat2", "kind": "stat", "statStack": true, "x": 640, "y": 543, "w": 380, "h": 313, "size": 150, "font": "bebas", "align": "left", "z": 18 },
    { "id": "stat3", "type": "text", "bind": "stat3", "kind": "stat", "statStack": true, "x": 640, "y": 856, "w": 380, "h": 314, "size": 150, "font": "bebas", "align": "left", "z": 18 },
    { "id": "footer", "type": "text", "bind": "footer", "x": 0, "y": 1296, "w": 1080, "size": 24, "color": "white", "font": "sans", "weight": 700, "align": "center", "ls": 1, "z": 20, "textTransform": "uppercase" }
  ]
}
