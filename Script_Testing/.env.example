# OpenRouter (recommended for this Script_Testing harness)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Use OpenRouter model ids, e.g. openai/gpt-4o-mini or google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional OpenRouter rankings headers
# OPENROUTER_REFERER=https://your-app.example
# OPENROUTER_TITLE=Poster Lab Script_Testing

# Legacy aliases still work (mapped automatically by the script):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
